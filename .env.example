# Generated from the Rhythm Compose files and the Pluxel application environment contract.
# Do not hand-edit .env.example; run pnpm deploy:env:generate in the Rhythm source workspace.

# Required for the recommended Cloudflare DNS-01 deployment.
# Canonical frontend HTTP(S) origin used in Rhythm control links. RHYTHM_PUBLIC_URL overrides this value at startup.
# Input: string (URL)
# Exact browser-facing frontend origin used in control links and browser security policy.
# Include the scheme and non-default port, with no non-root path, query, or fragment.
# The bundled frontend and API gateway use this origin by default.
# Keep the resulting .env file chmod 600.
RHYTHM_PUBLIC_URL=
# Cloudflare API Token scoped to this zone with Zone:Read and DNS:Edit.
# Do not use a Global API Key.
CF_API_TOKEN=
# Image tag used by both backend and gateway.
# Keep latest to follow the newest release when pulling, or pin a release/sha-* tag for reproducible deployments.
RHYTHM_VERSION=latest

# Recommended topology.
# Cloudflare DNS-01 on a public high HTTPS port; host ports 80/443 stay free.
COMPOSE_FILE=compose.yaml:compose.https.yaml

# Optional independent frontend/API topology.
# Public API gateway HTTP(S) origin. Defaults to the frontend origin; RHYTHM_GATEWAY_URL overrides it at startup.
# Input: string (URL)
# Set only when the public API gateway uses a different origin from RHYTHM_PUBLIC_URL.
# Its hostname is used for certificate issuance; include the scheme and non-default port.
# RHYTHM_GATEWAY_URL=

# Optional additional browser origins.
# Additional browser origins allowed to call the Rhythm API.
# Input: JSON array<string (length <= 2048)> (length <= 64)
# Additional browser origins allowed to call the API; the canonical frontend is automatic.
# RHYTHM_ALLOWED_ORIGINS=[]

# Optional image source.
# RHYTHM_IMAGE_REGISTRY=ghcr.io/pluxeljs

# Optional host paths.
# RHYTHM_DATA_DIR=./data
# RHYTHM_MUSIC_DIR=./music

# Direct public ACME alternative (requires public 80/443; no Cloudflare token).
# Use COMPOSE_FILE=compose.yaml:compose.https-direct.yaml.

# Direct-overlay TLS customization for a trusted internal CA deployment.
# RHYTHM_CADDY_TLS_DIRECTIVE=tls internal

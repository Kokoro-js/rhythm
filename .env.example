# Generated from the Rhythm Compose files and the Pluxel application environment contract.
# Do not hand-edit .env.example; run pnpm deploy:env:generate in the Rhythm source workspace.

# Required for the recommended Cloudflare DNS-01 deployment.
# Use a hostname only (no scheme, port, path, or wildcard). Keep this file chmod 600.
RHYTHM_DOMAIN=
# Cloudflare API Token scoped to this zone with Zone:Read and DNS:Edit.
# Do not use a Global API Key.
CF_API_TOKEN=

# Recommended public topology and immutable image selection.
# DNS-01 and a non-standard HTTPS port; no host port 80/443 required.
COMPOSE_FILE=compose.yaml:compose.https.yaml
RHYTHM_PUBLIC_PORT=31083
# Pin a release or sha-* tag in production.
RHYTHM_VERSION=latest

# Optional independent frontend origins.
# Browser origins allowed to call the Rhythm API.
# Input: JSON array<string (length <= 2048)> (length <= 64)
# Keep [] for the bundled same-origin page.
# RHYTHM_ALLOWED_ORIGINS=[]

# Optional image sources and Cloudflare-enabled Caddy build versions.
# RHYTHM_IMAGE_REGISTRY=ghcr.io/pluxeljs
# RHYTHM_CADDY_VERSION=2.11.4
# RHYTHM_CADDY_CLOUDFLARE_VERSION=v0.2.4

# Optional host paths and loopback-only diagnostic/Workbench ports.
# RHYTHM_DATA_DIR=./data
# RHYTHM_MUSIC_DIR=./music
# RHYTHM_HOST_BIND=127.0.0.1
# RHYTHM_HOST_PORT=3311
# RHYTHM_GATEWAY_BIND=127.0.0.1
# RHYTHM_GATEWAY_PORT=3310

# Optional runtime policy for documented recovery and local-demo cases.
# PLUXEL_WORKBENCH=true
# RHYTHM_FIX_OWNERSHIP=false
# RHYTHM_PUBLIC_SCHEME=https

# Optional Caddy listener address.
# RHYTHM_CADDY_BIND=0.0.0.0
# 0.0.0.0 is required for normal public access.

# Direct public ACME alternative (requires public 80/443; no Cloudflare token).
# RHYTHM_CADDY_HTTP_PORT=80
# RHYTHM_CADDY_IMAGE=docker.io/library/caddy:2.11.4-alpine
# Use COMPOSE_FILE=compose.yaml:compose.https-direct.yaml and RHYTHM_PUBLIC_PORT=443.

# Direct-overlay TLS customization for a trusted internal CA deployment.
# RHYTHM_CADDY_TLS_DIRECTIVE=tls internal

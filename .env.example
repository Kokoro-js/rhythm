# The standard deployment always starts the matching backend and public gateway together.
# Use the same immutable release tag for both images in production.
RHYTHM_IMAGE=ghcr.io/pluxeljs/rhythm:latest
RHYTHM_GATEWAY_IMAGE=ghcr.io/pluxeljs/rhythm-gateway:latest

# Production should use external PostgreSQL. Leave empty only for a local/demo PGlite deployment.
DATABASE_URL=
# Fail closed when production DATABASE_URL was omitted. Set false only for an explicit demo.
RHYTHM_REQUIRE_POSTGRES=true

# 3311 contains both /streamer and the private Pluxel management plane. Keep it on loopback.
RHYTHM_HOST_BIND=127.0.0.1
RHYTHM_HOST_PORT=3311

# This is the only upstream for the outer HTTPS reverse proxy. It serves the bundled SPA,
# forwards /streamer, and rejects /__pluxel. External frontends may use its public HTTPS origin.
RHYTHM_GATEWAY_BIND=127.0.0.1
RHYTHM_GATEWAY_PORT=3310

# Back up the data directory and PostgreSQL together. The music directory is mounted read-only.
RHYTHM_DATA_DIR=./data
RHYTHM_MUSIC_DIR=./music

# Set true for one start only when repairing ownership after a restore.
RHYTHM_FIX_OWNERSHIP=false

# Keep Workbench private on 3311 and reach it through an SSH tunnel.
PLUXEL_WORKBENCH=true
